---
import Config from '../../../e-initiative.config.mjs';
import SectionContainer from '../SectionContainer.astro';
import UpdateTimestamp from '../UpdateTimestamp.svelte';
import PenIcon from '../icons/PenIcon.svelte';
import { isCampaignEnded } from '../../utils/campaign';
import { countSubmittedDocuments } from '../../utils/firebase';
import { countOfflineSignatures } from '../../utils/sheets';
import Sharer from '../Sharer.svelte';
import { withBase } from '../../utils/url';

const documentCount = await countSubmittedDocuments();
---

<SectionContainer
	outerClass="min-h-screen justify-center bg-primary"
	innerClass="flex w-full flex-col items-center justify-center text-center "
	hideNavbar
	showMarquee
>
	<div
		class="flex w-full max-w-[850px] flex-col gap-2 text-center md:flex-row md:gap-10"
	>
		<div class="flex flex-col items-center justify-center gap-2 md:gap-5">
			<!-- <h1 class="heading-responsive-03">{Config.metadata.title}</h1>
		<p>{Config.metadata.description}</p> -->
			<img
				class="w-[220px] max-w-[280px] md:w-[280px]"
				src={withBase('image/logo-e.svg')}
				alt=""
			/>
			<p class="body-03-normal text-secondary">
				ขอคนละชื่อไม่เอาอำนาจ สว.<br />
				ไม่เอา สสร. ที่เราไม่ได้เลือก
			</p>
			<img class="" src={withBase('image/box.svg')} alt="" />
		</div>
		<div class="my-auto flex w-full flex-col">
			<p class="body-03-normal mt-1 text-secondary">
				ต้องการ {Config.petition.expectedSignatures.toLocaleString()} รายชื่อ
			</p>

			<div class="flex flex-col gap-3">
				<div>
					<p class="heading-responsive-02 text-secondary">
						ลงแล้ว {documentCount.toLocaleString()} คน
					</p>
					<p class="body-03-normal text-secondary">
						<!-- {dayElapsed > 0 && <>เหลือเวลาอีก {dayElapsed} วัน</>} -->
						ภายใน 30 มิ.ย. 2569
					</p>
					<UpdateTimestamp client:load date={new Date()} />
				</div>
				{
					isCampaignEnded ? (
						<div class="flex flex-row items-center gap-2">
							<div class="h-[2px] flex-1 bg-secondary" />
							<p class="font-bold text-secondary">ปิดรับลงชื่อแล้ว</p>
							<div class="h-[2px] flex-1 bg-secondary" />
						</div>
					) : (
						<div class="space-y-2">
							<a
								href="#sign"
								class="heading-03 btn btn-block border-none bg-secondary text-white hover:bg-secondary-focus"
							>
								ลงชื่อเลย
								<PenIcon />
							</a>
							{/* {Config.sheets?.enableLocations && (
								<a
									href="locations"
									class="heading-03 btn btn-secondary btn-block"
								>
									ดูสถานที่ลงชื่อ
									<LocationIcon />
								</a>
							)}
							{Config.petition.offline?.volunteer && (
								<a
									href="#volunteer"
									class="heading-03 btn btn-secondary btn-block"
								>
									อาสาล่ารายชื่อ
									<TableIcon />
								</a>
							)} */}
						</div>
					)
				}
			</div>

			<div class="mt-3 flex flex-col gap-2">
				<a
					class="heading-03 text-accent underline hover:text-accent-focus"
					href="#why">ทำไมต้องลงชื่อ</a
				>
				<a
					class="heading-03 text-accent underline hover:text-accent-focus"
					href="https://drive.google.com/drive/folders/1ngDOTvVdF3vaXfHX_ozQ2lvRaCGXWamD?usp=drive_link"
					target="_blank"
					rel="noopener noreferrer">ดาวน์โหลดไฟล์รณรงค์</a
				>
			</div>

			<div class="mt-3 flex items-center justify-center gap-3 text-secondary">
				<span class="body-01">แชร์</span>
				<Sharer />
			</div>
		</div>
	</div>
</SectionContainer>
