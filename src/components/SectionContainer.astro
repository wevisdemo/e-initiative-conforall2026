---
import Marquee from './Marquee.astro';

interface Props {
	id?: string;
	outerClass?: string;
	innerClass?: string;
	hideNavbar?: boolean;
	showMarquee?: boolean;
	landingHeight?: boolean;
}

const {
	id,
	outerClass,
	innerClass,
	hideNavbar,
	showMarquee = false,
	landingHeight = false,
} = Astro.props;
---

<div class="relative">
	<div class="absolute left-0 top-0 w-full">
		{showMarquee && <Marquee />}
	</div>
	{landingHeight && <div class="h-[30px] w-full md:h-[50px]" />}

	<div
		{id}
		class={` w-full flex flex-col items-center px-3 py-12  ${outerClass || ''}`}
		data-navbar={hideNavbar ? 'hide' : 'show'}
	>
		<div class={innerClass}>
			<slot />
		</div>
	</div>
</div>
